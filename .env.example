# Local development configuration. Copy to .env; never commit the real .env.
# Account credentials are stored as a password hash in the private database.
COOKIE_SECURE=0
TRUST_PROXY=0
# Optional database path; relative SQLite paths use Flask's instance directory.
# DATABASE_URL=sqlite:///parts.sqlite
# Optional backup directory; defaults to instance/backups.
# PARTSDB_BACKUP_DIR=/absolute/private/path/backups
REICHELT_SCRAPER_ENABLED=1
# REICHELT_BROWSER_PATH=/usr/bin/chromium
# Optional API key for the provider used during list import.
# REICHELT_API_KEY=
