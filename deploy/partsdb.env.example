DATABASE_URL=sqlite:////var/lib/partsdb/parts.sqlite
PARTSDB_BACKUP_DIR=/var/lib/partsdb/backups
COOKIE_SECURE=1
TRUST_PROXY=1
# Optional: everydata.io API key for explicit product suggestions during Reichelt import.
# REICHELT_API_KEY=
# Direct browser lookup for existing project items, no API key needed.
REICHELT_SCRAPER_ENABLED=1
# REICHELT_BROWSER_PATH=/usr/bin/chromium
